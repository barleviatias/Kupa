# Copy to .env and set your server-only MongoDB connection string.
# This default requires a local MongoDB instance and episode data.
# MONGO_DB_NAME explicitly selects the database, overriding the URI database.
# Never use a NEXT_PUBLIC_ prefix for this variable.
MONGO_URI=mongodb://127.0.0.1:27017/kupa_prod
MONGO_DB_NAME=kupa_prod
# Both a flag and an explicit pipe-separated episode ID allowlist are required.
TIMESTAMP_SEARCH_ENABLED=false
TIMESTAMP_EPISODE_IDS=יולנדה_3_6
# Server-only secret for Vercel's weekly cache-warming request.
CRON_SECRET=
